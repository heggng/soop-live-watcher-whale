{
  "manifest_version": 3,
  "name": "SOOP 방송 시작 알리미",
  "version": "2.3.1",
  "description": "브라우저 백그라운드에서 SOOP 방송 시작을 감지해 알림을 표시하고 방송 창을 자동으로 엽니다.",
  "minimum_chrome_version": "109",
  "permissions": [
    "alarms",
    "notifications",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://live.sooplive.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "SOOP 방송 시작 알리미",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
